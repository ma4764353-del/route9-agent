# Which LLM to use: "anthropic" or "gemini". Defaults to anthropic if unset.
LLM_PROVIDER=anthropic

# Needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Cheap model for testing -- swap to claude-opus-5 later if quality needs it
ANTHROPIC_MODEL=claude-haiku-4-5

# Needed if LLM_PROVIDER=gemini (get a free-tier key at aistudio.google.com, no Cloud Billing needed)
GEMINI_API_KEY=your-gemini-key-here

# Optional: order-notification SMS, texted to the restaurant the moment an order is
# confirmed. If any of these four are unset, notification is silently skipped -- safe
# to leave blank for local/CLI testing. Find Account SID + Auth Token in the Twilio
# Console (Account Dashboard) -- never share the Auth Token, it's a full-access secret.
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
# Your Twilio number (the one server.py/voice_main.py already answer calls on), e.g. +15555550100
TWILIO_SMS_FROM_NUMBER=
# The restaurant staff's phone number to text new orders to, e.g. +15555550123
RESTAURANT_NOTIFY_NUMBER=

# Needed for voice (local mic demo and real phone calls). Get a key at deepgram.com
DEEPGRAM_API_KEY=your-deepgram-key-here

# Optional: a separate Twilio number for the missed-call text-back mode
TWILIO_TEXTBACK_NUMBER=
